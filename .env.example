# Each line is KEY=value. Do not put anything after the value
# on the same line - it gets read as part of the value. If you want
# to write a note, put it on its own line starting with #.

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-replace-me
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# --- You ---
USER_NAME=John
USER_EMAIL=you@example.com
# Pick the one that matches where you live:
#   East coast: America/New_York
#   Central:    America/Chicago
#   Mountain:   America/Denver
#   West coast: America/Los_Angeles
#   Arizona:    America/Phoenix
#   Hawaii:     Pacific/Honolulu
USER_TIMEZONE=America/New_York

# --- Agent's own email (optional; leave as your own email if you skip) ---
AGENT_EMAIL=cos.john@gmail.com

# --- Google OAuth ---
# Download from https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_SECRETS=~/.config/cos/google_client_secrets.json

# --- Storage ---
COS_DATA_DIR=~/.local/share/cos

# --- Email loop ---
EMAIL_POLL_SECONDS=120

# --- Daily briefing ---
BRIEFING_HOUR=7
JOURNAL_REMINDER_HOUR=21
