# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# --- You ---
USER_NAME=John
USER_EMAIL=you@example.com
USER_TIMEZONE=America/Los_Angeles

# --- Agent's own email (optional; same as user email if you skip) ---
AGENT_EMAIL=cos.john@gmail.com

# --- Google OAuth ---
# Download from https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_SECRETS=~/.config/cos/google_client_secrets.json

# --- Storage ---
COS_DATA_DIR=~/.local/share/cos

# --- Email loop ---
EMAIL_POLL_SECONDS=120

# --- Daily briefing ---
BRIEFING_HOUR=7
JOURNAL_REMINDER_HOUR=21
